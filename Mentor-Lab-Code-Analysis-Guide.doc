  <h3>28.4 Command cheat sheet</h3>
  <pre># install (once per folder)
cd backend
npm.cmd install
cd ..\frontend
npm.cmd install

# development
cd backend
npm.cmd run dev
# second terminal
cd frontend
npm.cmd run dev

# production build
cd frontend
npm.cmd run lint
npm.cmd run build

# serve built app from Express
cd backend
npm.cmd start

# Windows port diagnosis
Get-NetTCPConnection -LocalPort 5000 -State Listen
Test-NetConnection localhost -Port 5000

# health of backend (no dedicated health route; SPA root)
curl.exe -i http://localhost:5000/

# login example
curl.exe -X POST http://localhost:5000/api/auth/login -H "Content-Type: application/json" -d "{\"email\":\"student@example.com\",\"password\":\"Secret123!\"}"</pre>

