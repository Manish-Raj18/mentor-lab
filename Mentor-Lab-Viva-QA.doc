    <tr><td valign="top">POST <code>/api/mocktest/add</code></td><td valign="top">Create a test manually</td><td valign="top">Token (admin role not checked)</td></tr>
    <tr><td valign="top">POST <code>/api/mocktest/:id/order</code></td><td valign="top">Create a Razorpay order</td><td valign="top">Token</td></tr>
    <tr><td valign="top">POST <code>/api/mocktest/:id/verify</code></td><td valign="top">Verify Razorpay signature</td><td valign="top">Token</td></tr>
    <tr><td valign="top">POST <code>/api/mocktest/:id/simulate-pay</code></td><td valign="top">Manual UPI fallback</td><td valign="top">Token</td></tr>
    <tr><td valign="top">GET <code>/api/mocktest/results/mine</code></td><td valign="top">List the student's results</td><td valign="top">Token</td></tr>
    <tr><td valign="top">GET <code>/api/mocktest/result/:resultId</code></td><td valign="top">Review one owned result</td><td valign="top">Token + owner</td></tr>
    <tr><td valign="top">GET <code>/api/certificate/progress/:course</code></td><td valign="top">Check progress, issue certificate</td><td valign="top">Token</td></tr>
