    <tr><td valign="top">GET <code>/api/mocktest</code></td><td valign="top">List tests without correct answers</td><td valign="top">Token</td></tr>
    <tr><td valign="top">GET <code>/api/mocktest/:id</code></td><td valign="top">Get one test, access-checked</td><td valign="top">Token + access</td></tr>
    <tr><td valign="top">POST <code>/api/mocktest/:id/submit</code></td><td valign="top">Submit answers and receive score</td><td valign="top">Token + access</td></tr>
