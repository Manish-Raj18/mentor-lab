    <tr><td valign="top">DELETE <code>/api/notes/:id</code></td><td valign="top">Delete a note and its GridFS file</td><td valign="top">Token (admin role not checked)</td></tr>
    <tr><td valign="top">GET <code>/api/pyq?universityId=</code></td><td valign="top">List PYQs for a university</td><td valign="top">Public</td></tr>
